    "    return a * b  \n",
    "\n",
    "print(multiply(3, 4))  # Output: 12\n",
    "\n",
    "print(multiply(5, 6))  # Output: 30\n",
    "\n",
    "print(multiply(7, 8))  # Output: 56 \n",
    "\n",
    "def square (x):\n",
    "    return multiply(x,x)\n",
    "\n",
    "print (square(4))\n",
    "\n"
   ]
