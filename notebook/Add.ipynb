   "source": [
    "def add(a, b):\n",
    "    return a + b\n",
    "\n",
    "print(add(3, 5)) \n",
    "\n",
    "def sum_list(numbers):\n",
    "    total = 0\n",
    "    for num in numbers:\n",
    "        total = add(total, num)\n",
    "    return total\n",
    "\n",
    "my_list = [1, 2, 3, 4, 5]\n",
    "print(sum_list(my_list))\n",
    "\n",
    "print(\"The sum of the list is:\", sum_list(my_list))"
   ]
  }
